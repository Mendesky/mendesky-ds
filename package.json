{
  "name": "@mendesky/ds",
  "version": "0.1.0",
  "description": "Mendesky Design System 本體：跟框架無關的樣式、圖示、工具程式、元件規格與文件網站",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/*": "./styles/*",
    "./scripts/export-docs.mjs": "./scripts/export-docs.mjs",
    "./scripts/component-refs.mjs": {
      "types": "./scripts/component-refs.d.mts",
      "default": "./scripts/component-refs.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "src/docs",
    "src/icons/icons.ts",
    "scripts/export-docs.mjs",
    "scripts/component-refs.mjs",
    "scripts/component-refs.d.mts",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scripts": "node --test scripts/",
    "check:docs": "node scripts/check-docs.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:styles": "node scripts/check-component-styles.mjs",
    "check:guides": "node scripts/check-guides.mjs",
    "site:dev": "vitepress dev site",
    "site:build": "bash scripts/build-site.sh",
    "smoke:guides": "node scripts/smoke-guides.mjs"
  },
  "peerDependencies": {
    "pdfjs-dist": "3.11.174"
  },
  "devDependencies": {
    "@playwright/test": "~1.59.0",
    "@vitest/browser": "3.2.7",
    "pdfjs-dist": "3.11.174",
    "playwright": "~1.59.0",
    "sass": "~1.99.0",
    "typescript": "~5.4.2",
    "vitepress": "^1.6.4",
    "vitest": "3.2.7",
    "vue": "^3.5.44"
  }
}
